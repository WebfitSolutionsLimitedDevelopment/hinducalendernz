# Display mode: preview (internal banner) | calculated (public, labelled unreviewed) | public (approved only)
DATA_MODE=preview
# Basic-auth password for the whole site; remove to go public
PREVIEW_PASSWORD=
SITE_URL=https://hinducalendar.co.nz

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; needed by the daily reminder job
SUPABASE_SECRET_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@hinducalendar.co.nz
# Vercel Cron bearer token
CRON_SECRET=

# Email (Resend): reminders, sign-in links via SMTP, and team notifications of form submissions
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Hindu Calendar NZ <info@webfitt.co.nz>"
NOTIFY_EMAIL=info@webfitt.co.nz
